# Anthropic API Key — required
# Get yours at: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your_api_key_here

# MongoDB Atlas connection string — required for semantic search
# Create a free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Booker Go backend URL (defaults to http://localhost:8080 if unset)
BOOKER_API_URL=http://localhost:8080

# Model Configuration
DEFAULT_MODEL=claude-sonnet-4-5-20250929
MAX_TOKENS=4096

# Memory Settings
CONVERSATION_HISTORY_LIMIT=50

# Observability
ENABLE_TRACING=true
LOG_LEVEL=INFO

# Agent Settings
MAX_AGENT_ITERATIONS=10

# Governance (optional — set to true to enable NeMo Guardrails + cost controls)
ENABLE_GOVERNANCE=false
GOVERNANCE_CONFIG=config/governance.yaml
